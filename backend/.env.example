APP_NAME=Divination API
APP_ENV=dev
APP_DEBUG=true

# Set false to disable all DB connections and persistence.
DB_PERSISTENCE_ENABLED=true

# Admin login (only admin can view stored records)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_SESSION_TTL_MINUTES=720

# Site access gate (blank entry page + password before divination UI/API)
SITE_GATE_ENABLED=true
SITE_GATE_PASSWORD=change_me_site_access
SITE_GATE_COOKIE_SECRET=change_me_site_gate_secret
SITE_GATE_TTL_SECONDS=604800
SITE_GATE_COOKIE_SECURE=false

USER_TOKEN_SECRET=change_me_user_token
USER_PASSWORD_AES_SECRET=change_me_user_password_aes_secret

# MySQL (recommended: split config, special chars in password are handled automatically)
DB_HOST=127.0.0.1
DB_PORT=32306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=divination
DB_CHARSET=utf8mb4

# Optional: use full URL instead (if password contains @, use %40)
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:32306/divination?charset=utf8mb4

# LLM config
OPENAI_BASE_URL=http://103.239.152.247:8022/v1
OPENAI_MODEL=qwen3.5-27b-fp8
OPENAI_API_KEY=replace_with_your_real_key
LLM_ENABLED=false
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=700
